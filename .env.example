# Copy to .env and change the passwords (letters and digits only).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# Optional: host ports.
# WEB_PORT=8080
# DB_PORT=3317

# Google sign-in is optional: without these two only guests can sign in.
# Create an "OAuth client ID" (type: Web application) in the Google Cloud
# console and register this redirect URI there:
#   <PUBLIC_URL>/api/auth/google/callback
# PUBLIC_URL=http://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Statistics of the Lichess opening explorer in the repository builder ("how many games
# played this move"). The explorer wants an access token: on lichess.org open
# Preferences -> API access tokens, create a token (no scopes are needed) and put it here.
# Without it the builder works with its own reference of opening theory.
# LICHESS_TOKEN=

# The AI coach of the review explains moves in words. It reaches a language model through
# OpenRouter (https://openrouter.ai/keys); what leaves the server is the position, the move and the
# engine's lines, never names or accounts. Without a key the coach is switched off. It uses FREE
# models, one after another when one is busy (the default list is in backend/internal/coach). A key
# without credit gets about 50 free requests a day; each person gets 40 new explanations an hour,
# and repeats are free (kept in the database). To choose models yourself, list OpenRouter model ids,
# comma separated; a paid one put last would be the last resort, e.g.
#   OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,anthropic/claude-haiku-5.5
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=

# The forum moderators: user ids (the 16 letters and digits in the address of a profile, #user/<id>),
# comma separated. They may delete any message or topic, pin a topic and close it.
# FORUM_ADMINS=

# Accounts that share a browser or a recent network address count as one person: they are not paired
# for a rated game or a duel, and a rated game between them does not move the ratings. Set to "off"
# to try matchmaking with two windows on one machine.
# SAME_PERSON_CHECK=on

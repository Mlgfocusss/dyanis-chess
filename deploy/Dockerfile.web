# React front end behind nginx, which also proxies /api to the Go server.
# Build context: repo root.
#
# The in-browser bot is the engine compiled to WebAssembly; it is built
# here from engine/cmd/wasm, so a fresh clone needs no manual preparation.

# 1. The engine as WebAssembly (+ the matching wasm_exec.js of this Go version).
FROM golang:1.26-alpine AS wasm
WORKDIR /src
COPY go.mod go.sum* ./
COPY engine/internal ./engine/internal
COPY engine/cmd/wasm ./engine/cmd/wasm
RUN mkdir /out && GOOS=js GOARCH=wasm go build -trimpath -ldflags="-s -w" -o /out/dyanis.wasm ./engine/cmd/wasm \
    && cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" /out/wasm_exec.js

# 2. The React app.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY --from=wasm /out/ ./public/wasm/
COPY engine/assets/*.bin ./public/assets/
RUN npm run build

# 3. nginx.
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
